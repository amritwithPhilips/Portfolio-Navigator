.claude/settings.local.json

# Working scripts (not part of deliverable)
.claude/*.py
.claude/*.js
.claude/*.json
.claude/*.csv

# Snapshot backups
Backups/

# Generated graph output
graphify-out/

# Large audit scenario dumps (exceed GitHub 100MB limit)
**/audit/scenarios.json
